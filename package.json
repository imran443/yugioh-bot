{
  "name": "yugioh-discord-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:engine": "npm run test:engine --workspace=@yugidraft/duel-server",
    "test:native": "npm run test:native --workspace=@yugidraft/duel-server",
    "seed": "tsx scripts/seed.ts",
    "reset:test-data": "npm run seed && docker compose restart web bot worker",
    "snapshot:draft-catalog": "tsx scripts/generate-draft-catalog-snapshot.ts",
    "dev:bot": "npm run dev --workspace=@yugioh-discord-bot/bot",
    "dev:ws": "npm run dev --workspace=@yugioh-discord-bot/ws",
    "dev:duel": "npm run dev --workspace=@yugidraft/duel-server",
    "duel:prepare": "npm run prepare:data --workspace=@yugidraft/duel-server",
    "dev:web": "npm run dev --workspace=@yugioh-discord-bot/web",
    "e2e": "npm run e2e --workspace=@yugidraft/e2e",
    "e2e:live-login": "npm run e2e:live-login --workspace=@yugidraft/e2e",
    "dev:worker": "npm run dev --workspace=@yugidraft/worker",
    "ops": "tsx packages/worker/src/ops/cli.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "turbo": "latest"
  },
  "dependencies": {
    "patch-package": "8.0.1"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
