DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REMINDER_CHANNEL_ID=
DISCORD_DEFAULT_CHANNEL_ID=

# --- Web App Auth (packages/web) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local: http://localhost:3000 | Production: http://YOUR_VM_PUBLIC_IP (Caddy serves port 80)
NEXTAUTH_URL=

# --- Bot Web URL (used in Discord announcement messages) ---
# Local: http://localhost:3000 | Production: http://YOUR_VM_PUBLIC_IP
WEB_URL=http://localhost:3000

# --- WebSocket Server (packages/ws) ---
# Local: http://localhost:3001 | Production: http://YOUR_VM_PUBLIC_IP (Caddy routes /socket.io/*)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# --- Internal HMAC channel: web -> ws broadcasts (packages/ws/src/internal-http.ts) ---
# Same secret must be set on both web and ws containers; web POSTs signed
# bodies to WS_INTERNAL_URL/internal/draft/{status,pick,resync,complete} so ws
# can fan them out to the draft room over Socket.IO.
# The bot also uses this channel to broadcast draft resyncs after pick expiry.
# Generate with: openssl rand -hex 32
WS_INTERNAL_SECRET=
# In docker-compose, web reaches ws by service name on the internal network:
WS_INTERNAL_URL=http://ws:4002

# --- Internal HMAC channel: web -> bot announces (packages/bot/src/announce/server.ts) ---
# Same shape as WS_INTERNAL_*. Web posts signed announces about new drafts and
# tournaments so the bot can echo them into Discord channels.
# Generate with: openssl rand -hex 32
BOT_ANNOUNCE_SECRET=
BOT_ANNOUNCE_URL=http://bot:4001

# --- Shared ---
DATABASE_PATH=./data/bot.sqlite
REMINDER_CRON=0 10 * * *
REMINDER_TIMEZONE=America/New_York
