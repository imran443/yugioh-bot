{
  "name": "@yugidraft/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./access/owner-access": {
      "types": "./dist/access/owner-access.d.ts",
      "source": "./src/access/owner-access.ts",
      "default": "./dist/access/owner-access.js"
    },
    "./duels": {
      "types": "./dist/duels/index.d.ts",
      "source": "./src/duels/index.ts",
      "default": "./dist/duels/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "source": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "source": "./src/services/index.ts",
      "default": "./dist/services/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "source": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./tournaments": {
      "types": "./dist/tournaments/index.d.ts",
      "source": "./src/tournaments/index.ts",
      "default": "./dist/tournaments/index.js"
    },
    "./util/web-slug": {
      "types": "./dist/util/web-slug.d.ts",
      "source": "./src/util/web-slug.ts",
      "default": "./dist/util/web-slug.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "source": "./src/ws/index.ts",
      "default": "./dist/ws/index.js"
    },
    "./ws/talk": {
      "types": "./dist/ws/talk.d.ts",
      "source": "./src/ws/talk.ts",
      "default": "./dist/ws/talk.js"
    },
    "./scoring": {
      "types": "./dist/scoring/index.d.ts",
      "source": "./src/scoring/index.ts",
      "default": "./dist/scoring/index.js"
    },
    "./clerk": {
      "types": "./dist/clerk/index.d.ts",
      "source": "./src/clerk/index.ts",
      "default": "./dist/clerk/index.js"
    },
    "./notify": {
      "types": "./dist/notify/index.d.ts",
      "source": "./src/notify/index.ts",
      "default": "./dist/notify/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "repair:ratings": "node dist/maintenance/repair-ratings.js",
    "backfill:artworks": "node dist/maintenance/backfill-card-artworks.js"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
