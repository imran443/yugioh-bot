# --- Discord Bot (packages/bot) ---
# Bot → Reset Token
DISCORD_TOKEN=
# General Information → Application ID (shared between bot and web OAuth)
DISCORD_CLIENT_ID=
# Discord Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REMINDER_CHANNEL_ID=
DISCORD_DEFAULT_CHANNEL_ID=

# --- Web App Auth (packages/web) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local: http://localhost:3000 | Production: https://your-domain.com
NEXTAUTH_URL=

# --- WebSocket Server (packages/ws) ---
NEXT_PUBLIC_WS_URL=http://localhost:3001

# --- Shared ---
DATABASE_PATH=./data/bot.sqlite
REMINDER_CRON=0 10 * * *
REMINDER_TIMEZONE=America/New_York